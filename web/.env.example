# Kopiér til .env.local og udfyld med værdier fra shelterdk/.env (eller Supabase Dashboard)
# NEXT_PUBLIC_SUPABASE_URL=https://dit-projekt.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-key

# Valgfrit: server-side page_view for "Kun nødvendige"-brugere (GA4 Measurement Protocol)
# GA4: Admin → Data streams → [din stream] → Measurement Protocol API secrets → Create
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=din-api-secret

# Valgfrit: modtag booking-system alerts på email (kommaseparer flere modtagere)
# BOOKING_ALERT_EMAIL=dig@eksempel.dk

# Valgfrit: modtag en intern mail ved hver ny bekræftet booking
# Falder tilbage til BOOKING_ALERT_EMAIL hvis denne ikke er sat.
# BOOKING_NOTIFICATION_EMAIL=dig@eksempel.dk

# Valgfrit: Sentry error-monitoring
# Setup: opret konto på sentry.io → New Project → Next.js → kopier DSN
# Begge variabler peger på samme DSN; den "NEXT_PUBLIC"-version er nødvendig
# for at klient-side fejl kan rapportere ind.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXXX.ingest.sentry.io/XXXXX
# SENTRY_DSN=https://xxxxx@oXXXXX.ingest.sentry.io/XXXXX
#
# Til source-map upload på build (kun nødvendigt i CI/Netlify build env):
# SENTRY_ORG=dit-org-slug
# SENTRY_PROJECT=shelterdk
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxx  (Sentry → Settings → Auth Tokens)
#
# Valgfrit: spor releases via commit-sha
# SENTRY_RELEASE=$COMMIT_REF        (Netlify auto-injecter denne)
# NEXT_PUBLIC_SENTRY_RELEASE=$COMMIT_REF
