# Kopiér til .env.local og udfyld med værdier fra shelterdk/.env (eller Supabase Dashboard)
# NEXT_PUBLIC_SUPABASE_URL=https://dit-projekt.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-key

# Valgfrit: server-side page_view for "Kun nødvendige"-brugere (GA4 Measurement Protocol)
# GA4: Admin → Data streams → [din stream] → Measurement Protocol API secrets → Create
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=din-api-secret

# Valgfrit: modtag booking-system alerts på email (kommaseparer flere modtagere)
# BOOKING_ALERT_EMAIL=dig@eksempel.dk
